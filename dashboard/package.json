{
  "name": "sigmaevolve-dashboard",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "python3 ../scripts/infisical/run.py dev",
    "build": "next build",
    "start": "node ../scripts/dev-server.mjs next start",
    "sentry:env:push": "node scripts/push-sentry-env.mjs",
    "test": "vitest run",
    "dev:app": "node ../scripts/dev-server.mjs next dev",
    "build:secrets": "python3 ../scripts/infisical/run.py build",
    "secrets:check": "python3 ../scripts/infisical/run.py check",
    "secrets:migrate:keyenv": "python3 ../scripts/infisical/migrate_keyenv.py",
    "test:secrets": "python3 -m unittest discover -s ../scripts/infisical -p test_secrets.py"
  },
  "dependencies": {
    "@sentry/nextjs": "11.2.0",
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@opentelemetry/core": "2.8.0",
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.8",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.5",
    "vite": "8.0.16",
    "ws": "8.21.0",
    "source-map-js": "1.2.2"
  }
